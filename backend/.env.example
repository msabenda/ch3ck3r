# Ch3ck3r Backend — Environment Configuration
# Copy to .env and fill in secrets

# Application
APP_NAME=Ch3ck3r
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=change-me-to-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql+asyncpg://ch3ck3r:ch3ck3r@localhost:5432/ch3ck3r

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Scanner
SCAN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SCANS=5
SCAN_RESULT_RETENTION_DAYS=90

# External Tools (optional paths)
ZAP_PATH=/usr/bin/zap.sh
NUCLEI_PATH=/usr/bin/nuclei
SEMGREP_PATH=/usr/bin/semgrep

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Alerting ────────────────────────────────────────────────────
# Slack Webhook
SLACK_WEBHOOK_URL=

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Generic Webhooks (comma-separated)
ALERT_WEBHOOK_URLS=

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ch3ck3r@localhost
SMTP_USE_TLS=true
ALERT_EMAIL_TO=
CH3CK3R_URL=http://localhost:3000
